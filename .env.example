# ========================================================
# ChatGPT-Style AI Platform - Environment Configuration
# ========================================================

# Database (PostgreSQL URL for production / Render / Supabase / Neon)
# If left empty, automatically falls back to local SQLite: sqlite:///./chatgpt.db
DATABASE_URL=postgresql://chatgpt_user:chatgpt_password_2026@localhost:5432/chatgpt_db

# Security
JWT_SECRET_KEY=super-secure-chatgpt-jwt-key-2026

# Hosted LLM Inference Service (OpenAI-compatible Endpoint)
# Compatible with Groq, OpenAI, Together AI, OpenRouter, Hugging Face
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
